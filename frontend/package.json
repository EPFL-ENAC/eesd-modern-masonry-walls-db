{
  "name": "modernmasonrydatabase",
  "version": "0.0.0",
  "description": "Open database of in-plane shear-compression tests on modern unreinforced masonry walls",
  "productName": "Modern Masonry Database",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.{css,scss,vue}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest",
    "convert": "node scripts/convert-data.ts",
    "optimize-images": "node scripts/optimize-images.ts"
  },
  "dependencies": {
    "@quasar/extras": "=1.18.0",
    "echarts": "=6.1.0",
    "epfl-design-system": "github:EPFL-ENAC/epfl-design-skill#30818ba2036bea3507e9064cfc2b5eeb01771b27",
    "jszip": "^3.10.1",
    "quasar": "^2.33.2",
    "vue": "=3.5.43",
    "vue-echarts": "=8.3.1",
    "vue-i18n": "=11.4.12",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "=10.0.1",
    "@quasar/app-vite": "=3.10.0",
    "@types/node": "=24.13.6",
    "@vue/eslint-config-typescript": "=14.9.0",
    "autoprefixer": "=10.6.1",
    "eslint": "=10.11.0",
    "eslint-config-prettier": "=10.1.8",
    "eslint-plugin-vue": "=10.11.1",
    "globals": "=17.12.0",
    "postcss-html": "^1.8.0",
    "prettier": "=3.9.9",
    "sass": "=1.105.0",
    "sharp": "^0.35.5",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "=17.0.0",
    "typescript": "=5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "=10.4.1",
    "vue-tsc": "=3.3.11"
  }
}
